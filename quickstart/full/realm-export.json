{
  "id": "scriptbee",
  "realm": "scriptbee",
  "enabled": true,
  "clients": [
    {
      "clientId": "scriptbee-client",
      "publicClient": true,
      "redirectUris": ["*"],
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "scriptbee-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "aud"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "test",
      "enabled": true,
      "credentials": [
        {"type": "password", "value": "test"}
      ]
    }
  ]
}
