{
  "id": "scriptbee",
  "realm": "scriptbee",
  "enabled": true,
  "clients": [
    {
      "clientId": "scriptbee-client",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:4201/*"
      ],
      "webOrigins": [
        "http://localhost:4201"
      ],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "scriptbee-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "aud"
          }
        }
      ]
    },
    {
      "clientId": "scriptbee-api",
      "publicClient": false,
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "bearerOnly": false
    }
  ],
  "users": [
    {
      "username": "test",
      "enabled": true,
      "email": "test@scriptbee.local",
      "firstName": "Test",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "test"
        }
      ]
    }
  ]
}
